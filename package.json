{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:wasm": "mkdir -p public/wasm && emcc -O3 -s WASM=1 -s STANDALONE_WASM=1 --no-entry -I c c/maze.c c/queue.c c/stack.c c/bfs.c c/dfs.c c/wasm_bridge.c -o public/wasm/maze.wasm",
    "build:c-cli": "gcc -Wall -Wextra -O2 -std=c99 -I c c/maze.c c/queue.c c/stack.c c/bfs.c c/dfs.c c/main.c -o maze_cli",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js maze_cli",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
